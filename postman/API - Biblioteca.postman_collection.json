{
  "info": {
    "name": "API - Biblioteca",
    "description": "Ejecutar en orden desde 01 Crear libro. Los identificadores se guardan automáticamente. La primera carpeta contiene las ocho pruebas principales para las capturas del documento. Los datos son ficticios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8001"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"01 Crear libro\") {",
          "  const runId = Date.now().toString();",
          "  pm.collectionVariables.set(\"runId\", runId);",
          "  function isbn(prefix) {",
          "    const base = prefix + runId.slice(-9);",
          "    let sum = 0;",
          "    for (let i = 0; i < 12; i++) sum += Number(base[i]) * (i % 2 === 0 ? 1 : 3);",
          "    return base + ((10 - sum % 10) % 10);",
          "  }",
          "  pm.collectionVariables.set(\"isbn\", isbn(\"978\"));",
          "  pm.collectionVariables.set(\"isbnTemporal\", isbn(\"979\"));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Pruebas principales",
      "item": [
        {
          "name": "01 Crear libro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/libros",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"{{isbn}}\",\n  \"titulo\": \"Libro de prueba\",\n  \"autor\": \"Autor de prueba\",\n  \"anioPublicacion\": 2020,\n  \"numeroEjemplares\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Un ejemplar disponible\", () => pm.expect(pm.response.json().ejemplaresDisponibles).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/usuarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellidos\": \"Prueba\",\n  \"email\": \"ana.{{runId}}@example.com\",\n  \"password\": \"BibliotecaDemo2026!\",\n  \"rol\": \"SOCIO\",\n  \"estado\": \"ACTIVO\",\n  \"fechaNacimiento\": \"2000-01-15\",\n  \"telefono\": \"5550000000\",\n  \"direccion\": \"Calle Ejemplo 100\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"usuarioId\", pm.response.json().id);",
                  "pm.test(\"La contraseña no aparece en la respuesta\", () => pm.expect(pm.response.json()).not.to.have.property(\"password\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Registrar préstamo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/prestamos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"libro\": {\n    \"isbn\": \"{{isbn}}\"\n  },\n  \"usuario\": {\n    \"id\": \"{{usuarioId}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"prestamoId\", pm.response.json().id);",
                  "pm.test(\"Préstamo activo sin fecha de devolución\", () => pm.expect(pm.response.json().fechaDevolucion).to.eql(null));",
                  "pm.test(\"Fecha de préstamo registrada\", () => pm.expect(pm.response.json().fechaPrestamo).to.match(/^\\d{4}-\\d{2}-\\d{2}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Consultar libros",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/libros"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"El libro prestado tiene cero disponibles\", () => pm.expect(pm.response.json().find(l => l.isbn === pm.collectionVariables.get(\"isbn\")).ejemplaresDisponibles).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Consultar préstamos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/prestamos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Rechazar préstamo duplicado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/prestamos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"libro\": {\n    \"isbn\": \"{{isbn}}\"\n  },\n  \"usuario\": {\n    \"id\": \"{{usuarioId}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Mensaje de préstamo duplicado\", () => pm.expect(pm.response.json().error).to.include(\"préstamo activo\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Devolver libro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/prestamos/{{prestamoId}}/devolver"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devolución con fecha registrada\", () => pm.expect(pm.response.json().fechaDevolucion).to.match(/^\\d{4}-\\d{2}-\\d{2}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Consultar disponibilidad después de devolver",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/libros/{{isbn}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"El ejemplar vuelve a estar disponible\", () => pm.expect(pm.response.json().ejemplaresDisponibles).to.eql(1));"
                ]
              }
            }
          ]
        }
      ]
    },
